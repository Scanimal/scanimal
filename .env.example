# ── Cloudflare D1 (for drizzle-kit push/migrate) ─────────────────────────────
# Only needed for running drizzle-kit migration commands locally.
# At runtime the DB is accessed via the D1 binding in wrangler.jsonc.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

# ── App ───────────────────────────────────────────────────────────────────────
# Set to your deployed Workers URL or http://localhost:5173 for local dev.
ORIGIN=""

# ── Better Auth ───────────────────────────────────────────────────────────────
# 32+ character random string. Generate with: openssl rand -base64 32
# For production, set via: wrangler secret put BETTER_AUTH_SECRET
# For local dev, put in .dev.vars (gitignored):
#   BETTER_AUTH_SECRET="..."
BETTER_AUTH_SECRET=""

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scanimal",
  "compatibility_date": "2026-04-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "workers_dev": true,
  "preview_urls": true,

  // Resource IDs are deliberately omitted below. Wrangler and the "Deploy to
  // Cloudflare" button provision missing D1/KV/R2 resources automatically and
  // keep them linked across deploys, so no ID needs to be committed. Adding one
  // here would point every deploy at one specific account's resources.

  // ── D1 (SQLite) — source of truth. The write path. Never read on redirects. ──
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scanimal-db",
      "migrations_dir": "drizzle"
    }
  ],

  // ── KV — slug → destination hot cache. The redirect read path. ─────────────
  "kv_namespaces": [
    {
      "binding": "LINKS",
    },
  ],

  // ── Workers Analytics Engine — scan events. Never write scans to D1. ───────
  "analytics_engine_datasets": [
    {
      "binding": "SCANS",
      "dataset": "qr_scans",
    },
  ],

  // ── Email Sending (beta) — magic links + invites only. Requires Workers Paid
  //    and the sending domain on Cloudflare DNS. Optional: set EMAIL_PROVIDER=resend
  //    to use Resend instead (no Workers Paid required).
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],

  // ── R2 — logo uploads for styled QR codes. ─────────────────────────────────
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "scanimal-assets",
    },
  ],
}
